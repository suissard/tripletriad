# =============================================
# Triple Triad — Environment Configuration
# =============================================
# ⚠️  Ne pas commettre ce fichier dans Git
# Copie .env.example → .env et modifie les secrets
# =============================================

# ── Strapi (Back-end) ──
STRAPI_PORT=1340
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
JWT_SECRET=ton-secret-ici
ADMIN_JWT_SECRET=ton-secret-ici
APP_KEYS=key1,key2

# ── Front-end ──
FRONT_PORT=5180
FRONT_HOST=0.0.0.0
VITE_STRAPI_URL=http://localhost:${STRAPI_PORT}

# ── Front-page (public) ──
# Pour affichage du site (landing page, docs...)
WEBSITE_URL=http://localhost:${FRONT_PORT}
