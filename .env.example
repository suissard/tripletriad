# ============================================
# Terra Nullius — Environment Configuration
# ============================================
# ⚠️  Ne JAMAIS commiter .env (il est ignoré par Git).
# Copie ce fichier : cp .env.example .env  puis remplace chaque valeur "change-me".
# Génération d'un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Toutes les variables sont obligatoires : docker compose refuse de démarrer s'il en manque une.
# ============================================

# ── Strapi (Back-end) ──
STRAPI_PORT=1340
DATABASE_CLIENT=postgres
DATABASE_HOST=terra-nullius-db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me
DATABASE_FILENAME=.tmp/data.db
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
# 4 clés séparées par des virgules
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me
FRONT_URL=http://localhost:5180
APP_DOMAIN=localhost
# Exécute le bootstrap complet (permissions, cartes, histoires...) au démarrage
STRAPI_AUTO_INIT=true

# ── Front-end ──
VITE_STRAPI_URL=http://127.0.0.1:1340
FRONT_PORT=5180
FRONT_HOST=0.0.0.0

# ── Strapi Admin Credentials (scripts de seed / backup) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
