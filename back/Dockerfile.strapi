FROM node:24.14.0-alpine

WORKDIR /opt/app

# Install native dependencies for some node modules
RUN apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev > /dev/null 2>&1

# Copy package metadata first to leverage Docker cache
COPY strapi/package*.json ./

# Install dependencies
RUN npm install

# Copy application files (expecting context to be back/ or similar)
# We will just copy the contents of the strapi directory
COPY strapi/ .

# Expose Strapi port
EXPOSE 1337

# Default command
CMD ["npm", "run", "develop"]
