{
  "kind": "collectionType",
  "collectionName": "collections",
  "info": {
    "singularName": "collection",
    "pluralName": "collections",
    "displayName": "Collection",
    "description": "Card Collections (sets)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "cards": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::card.card",
      "mappedBy": "collections"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "boosterImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "boosterCostMultiplier": {
      "type": "decimal",
      "default": 1.0
    },
    "premiumBoosterCostMultiplier": {
      "type": "decimal",
      "default": 1.0
    },
    "startDate": {
      "type": "datetime"
    }
  }
}
