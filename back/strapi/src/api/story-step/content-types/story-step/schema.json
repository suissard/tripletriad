{
  "kind": "collectionType",
  "collectionName": "story_steps",
  "info": {
    "singularName": "story-step",
    "pluralName": "story-steps",
    "displayName": "Story Step",
    "description": "An individual step or battle in a story mode chapter"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "story": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::story.story",
      "inversedBy": "steps"
    },
    "situations": {
      "type": "dynamiczone",
      "components": [
        "story.situation-dialogue",
        "story.situation-battle",
        "story.situation-choice",
        "story.situation-reward",
        "story.situation-game-over",
        "story.situation-success"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "conditions": {
      "type": "component",
      "repeatable": true,
      "component": "story.choice-condition"
    }
  }
}