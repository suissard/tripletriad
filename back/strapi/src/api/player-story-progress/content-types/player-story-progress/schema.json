{
  "kind": "collectionType",
  "collectionName": "player_story_progresses",
  "info": {
    "singularName": "player-story-progress",
    "pluralName": "player-story-progresses",
    "displayName": "Player Story Progress",
    "description": "Tracks a player's progress through a story"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "story": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::story.story"
    },
    "completedSteps": {
      "type": "json"
    },
    "progressStatus": {
      "type": "enumeration",
      "enum": [
        "locked",
        "in_progress",
        "completed"
      ],
      "default": "locked"
    },
    "currentStep": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::story-step.story-step"
    },
    "currentSituationId": {
      "type": "string"
    },
    "stepHistory": {
      "type": "json",
      "description": "JSON array tracking the path taken and results in the current step"
    },
    "variables": {
      "type": "json",
      "description": "JSON object storing story-specific flags and counters"
    }
  }
}
