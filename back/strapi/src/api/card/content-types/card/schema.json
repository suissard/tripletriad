{
  "kind": "collectionType",
  "collectionName": "cards",
  "info": {
    "singularName": "card",
    "pluralName": "cards",
    "displayName": "Card",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "element": {
      "type": "enumeration",
      "default": "None",
      "enum": [
        "None",
        "eau",
        "faille_dimensionnelle",
        "furtif",
        "hacking",
        "longue_portee",
        "obsidienne",
        "radiation",
        "reseau",
        "spore"
      ]
    },
    "elements": {
      "type": "json"
    },
    "faction": {
      "type": "enumeration",
      "default": "neutre",
      "enum": [
        "neutre",
        "Hégémonie Martienne",
        "Exode Pélagique",
        "Héritiers des Cendres",
        "Omni-Réseau",
        "Chœur Synthétique",
        "Éveil Chthonien",
        "Incursion Dissonante",
        "Ferrailleurs de la Ceinture",
        "Fléau Spore"
      ]
    },
    "topValue": {
      "type": "string",
      "maxLength": 1,
      "required": true
    },
    "rightValue": {
      "type": "string",
      "maxLength": 1,
      "required": true
    },
    "bottomValue": {
      "type": "string",
      "maxLength": 1,
      "required": true
    },
    "leftValue": {
      "type": "string",
      "maxLength": 1,
      "required": true
    },
    "skills": {
      "type": "component",
      "repeatable": true,
      "component": "game.skill"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "collection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collection.collection",
      "inversedBy": "cards"
    },
    "rarity": {
      "type": "enumeration",
      "default": "Common",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary"
      ]
    },

    "defaultHp": {
      "type": "integer",
      "default": 3,
      "required": true
    },
    "level": {
      "type": "integer",
      "default": 1
    },

    "prompt": {
      "type": "json"
    }
  }
}