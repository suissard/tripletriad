{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "collection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::collection.collection",
      "mappedBy": "user"
    },
    "wallet": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::wallet.wallet",
      "mappedBy": "user"
    },
    "sentFriendships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::friendship.friendship",
      "mappedBy": "requester"
    },
    "receivedFriendships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::friendship.friendship",
      "mappedBy": "receiver"
    },
    "playerEventLogs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::player-event-log.player-event-log",
      "mappedBy": "user"
    },
    "playerQuests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::player-quest.player-quest",
      "mappedBy": "user"
    },
    "weeklyQuestProgresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::weekly-quest-progress.weekly-quest-progress",
      "mappedBy": "user"
    },
    "playerStoryProgresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::player-story-progress.player-story-progress",
      "mappedBy": "user"
    },
    "decks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::deck.deck",
      "mappedBy": "user"
    },
    "matchHistoryHost": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::match.match",
      "mappedBy": "hostUser"
    },
    "matchHistoryGuest": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::match.match",
      "mappedBy": "guestUser"
    },
    "unlockedCardFrames": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::card-frame.card-frame"
    },
    "defaultCardFrame": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::card-frame.card-frame"
    },
    "unlockedCardBacks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::card-back.card-back"
    },
    "defaultCardBack": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::card-back.card-back"
    },
    "avatar_card": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::card.card"
    },
    "guilds": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guild.guild",
      "mappedBy": "members"
    },
    "sentMessages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chat-message.chat-message",
      "mappedBy": "sender"
    },
    "receivedMessages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chat-message.chat-message",
      "mappedBy": "receiver"
    },
    "ownedGuilds": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::guild.guild",
      "mappedBy": "owner"
    },
    "moderatedGuilds": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guild.guild",
      "mappedBy": "moderators"
    }
  }
}
